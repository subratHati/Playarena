PORT=5000
MONGO_URI=mongodb://127.0.0.1:27017/playarena
JWT_SECRET=change-me-to-a-long-random-string
# Comma-separated list of allowed frontend origins
CLIENT_URL=http://localhost:5173

# Emails that get the admin role when they sign up (admins can create/delete tournaments and see participants)
ADMIN_EMAILS=admin@playarena.dev

# Lobby check-in opens this many minutes before a tournament starts, and closes at start time
CHECKIN_OPENS_MINUTES=15
# In a tournament match, a player who doesn't show up within this many seconds loses by walkover
NO_SHOW_SECONDS=60

# Stone Paper Scissors timers (milliseconds): first round, later rounds, result pause
SPS_FIRST_PICK_MS=10000
SPS_PICK_MS=3000
SPS_REVEAL_MS=1000
# In tournaments, a player who doesn't press Ready within this many seconds loses the match
SPS_READY_SECONDS=60
# A player who disconnects mid-match forfeits if not back within this many seconds
RECONNECT_SECONDS=30

# Random "Find an opponent" matchmaking: 1 = on, anything else = shows "Coming soon"
ENABLE_MATCHMAKING=0

# Abuse limits: signups per IP per hour, failed logins per IP per 15 min
SIGNUP_LIMIT_PER_HOUR=20
LOGIN_FAIL_LIMIT=10

# Production only (set NODE_ENV=production on your host):
# NODE_ENV=production
# ADMIN_PASSWORD=used once by `npm run seed` to create the admin account

# Email via Brevo (brevo.com → SMTP & API → API keys). Without a key, emails are printed in this terminal.
BREVO_API_KEY=
# Sender address you verified in Brevo (Senders, domains & dedicated IPs → Senders)
EMAIL_FROM=
EMAIL_FROM_NAME=MivoPlay
# Times in emails are shown in this timezone
EMAIL_TIMEZONE=Asia/Kolkata
# Reminder email this many minutes before a tournament starts (0 = off)
REMINDER_MINUTES=30
# Password reset requests per IP per hour
RESET_LIMIT_PER_HOUR=5
# Where links in emails point. Defaults to the first CLIENT_URL.
# APP_URL=https://mivoplay.fun

# ---------- Payment gateways (all optional; see DEPLOY.md §9) ----------
# Checkout offers each gateway whose keys are set. With none set, a test checkout (no real money) is used.
# MOCK_PAYMENTS=1 keeps the test checkout next to real gateways (testing only); 0 hides it.
# MOCK_PAYMENTS=
# Public https address of this API, for payment notification links
# API_PUBLIC_URL=https://api.mivoplay.fun

RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

CASHFREE_APP_ID=
CASHFREE_SECRET_KEY=
# sandbox or production
CASHFREE_ENV=sandbox

PHONEPE_CLIENT_ID=
PHONEPE_CLIENT_SECRET=
PHONEPE_CLIENT_VERSION=1
# sandbox or production
PHONEPE_ENV=sandbox
PHONEPE_WEBHOOK_USERNAME=
PHONEPE_WEBHOOK_PASSWORD=
